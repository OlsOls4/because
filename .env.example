# Copy to .env.local (gitignored). Placeholders only - never commit real values.

# --- Data harness -------------------------------------------------------------
# zetaris = federated SQL through Zetaris Lightning (primary)
# duckdb  = local fallback over the same public sources (no install needed)
BECAUSE_BACKEND=duckdb
# SAMPLE_MODE=1 forces the DuckDB fallback regardless of BECAUSE_BACKEND
SAMPLE_MODE=
# SEC EDGAR requires "app_name contact@email" as User-Agent
BECAUSE_USER_AGENT="because-agent you@example.com"

# --- Zetaris (filled in by scripts/zetaris_setup.sh) -------------------------
ZETARIS_CHANNEL=jdbc
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=/abs/path/to/zetaris-platform/jdbc/ndp-jdbc-driver-x.y.z-driver.jar
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Optional REST channel (instances with an API key)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html lets Zetaris register FRED too.
# Without it, FRED queries are answered by the local harness and labelled "hybrid" in the trace.
FRED_API_KEY=
BECAUSE_ZETARIS_HYBRID=1

# --- LLM (optional; all free tiers; auto picks the first key present) --------
BECAUSE_LLM_PROVIDER=auto
NVIDIA_API_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Misc ----------------------------------------------------------------------
# Where memory (H-MEM) and the HTTP cache live
BECAUSE_HOME=.because
# Background context from Wikipedia (1) and GDELT recent news (opt-in, shared rate limit)
BECAUSE_BACKGROUND=1
BECAUSE_GDELT=0
# Scout contract signing secret (random per process if unset)
SCOUT_SIGNING_SECRET=
